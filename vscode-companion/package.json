{
  "name": "pulse-companion",
  "displayName": "Pulse Companion",
  "description": "Open the exact local Copilot conversation selected in Pulse.",
  "version": "0.1.0",
  "publisher": "agent-pulse-local",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pulseCompanion.status",
        "title": "Pulse: Show Connection Status"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --out ../.artifacts/pulse-companion.vsix --allow-missing-repository --skip-license"
  }
}
